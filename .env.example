# Node does not auto-load this file. Use node --env-file=.env backend/server.js if needed.
NODE_ENV=production
PORT=3000
DB_PATH=data/aquarium.sqlite
# For HTTP on your own computer only. Set true when deployed behind HTTPS.
COOKIE_SECURE=false
# Set the exact HTTPS public origin when using a reverse proxy (no trailing slash).
PUBLIC_ORIGIN=http://localhost:3000
