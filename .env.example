# Node does not auto-load this file. Use node --env-file=.env backend/server.js if needed.
NODE_ENV=production
PORT=3000
DB_PATH=data/aquarium.sqlite
# For HTTP on your own computer only. Set true when deployed behind HTTPS.
COOKIE_SECURE=false
# Set the exact HTTPS public origin when using a reverse proxy (no trailing slash).
PUBLIC_ORIGIN=http://localhost:3000
# GitHub Pages frontend origin ONLY, without /dream-aquarium/ path.
# Leave empty for local same-origin play.
FRONTEND_ORIGIN=
# Set only to the actual number of trusted reverse proxies (e.g. 1 on configured hosting).
TRUST_PROXY_HOPS=
# Build-time public values, never credentials:
# VITE_BASE=/dream-aquarium/
# VITE_API_URL=https://YOUR-ACTUAL-BACKEND-HOST
