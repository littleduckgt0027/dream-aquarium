{
  "name": "dream-aquarium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node backend/server.js",
    "build": "vite build",
    "start": "node backend/server.js --production",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "db:migrate": "node backend/migrate.js",
    "format": "prettier --write backend frontend/src shared tests scripts/*.js vite.config.js playwright.config.js",
    "package:windows": "npm run build && node scripts/package-windows.js",
    "test:pages": "node scripts/test-pages.js",
    "test:postgres": "node scripts/test-postgres.js",
    "db:import:sqlite": "node scripts/import-sqlite.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.10",
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
